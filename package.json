{
  "name": "museum-of-alternative-displays",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A vendor-neutral digital museum of alternative display technologies.",
  "scripts": {
    "dev": "npm run i18n && vite",
    "i18n": "tsx scripts/i18n.ts build",
    "i18n:drafts": "tsx scripts/i18n.ts build --drafts",
    "i18n:sync": "tsx scripts/i18n.ts sync",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts && tsx scripts/view-spots.ts",
    "check": "npm run i18n && npm run typecheck && npm run validate",
    "build": "npm run i18n && vite build",
    "crawl": "python3 scripts/crawl.py dist",
    "preview": "vite preview",
    "posters": "node scripts/posters.mjs",
    "cutouts": "node scripts/cutouts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/sofia-sans": "^5.3.0",
    "@fontsource-variable/sofia-sans-extra-condensed": "^5.3.0",
    "@fontsource/pt-mono": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "gettext-parser": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
