# Translation of the Museum of Alternative Displays into Español.
# How to work on this file: TRANSLATING.md at the top of the repository.
# 
# Español. The Spanish of Spain, with the visitor addressed as "tú".
# The guided tours (tour.*) are spoken by a guide from the River Plate, with voseo, by the owner's choice.
# Button names quoted in them stay as the screen shows them.
# A display with a picture surface is a "pantalla", a readout of fixed segments is a "visualizador", a board is a "panel".
# The room every piece stands in is "la habitación", so that "sala" stays free for the seven halls.
msgid ""
msgstr ""
"Project-Id-Version: Museum of Alternative Displays\n"
"Report-Msgid-Bugs-To: https://github.com/obartra/museum-of-alternative-displays/issues\n"
"Language: es\n"
"Language-Team: Español\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

