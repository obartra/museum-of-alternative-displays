msgctxt "ui.about.app.install"
msgid "Install the app"
msgstr "Instalar o aplicativo"

#: interface
#. About page.
msgctxt "ui.about.app.ios"
msgid "On an iPhone or iPad, tap Share in Safari, then Add to Home Screen."
msgstr "Em um iPhone ou iPad, toque em Compartilhar no Safari e depois em Adicionar à Tela de Início."

